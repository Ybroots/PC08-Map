{
  "name": "@atgt/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests"
  },
  "dependencies": {
    "@atgt/domain": "workspace:*",
    "@atgt/config": "workspace:*",
    "@atgt/contracts": "workspace:*",
    "@atgt/observability": "workspace:*",
    "@aws-sdk/client-s3": "^3.1111.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
