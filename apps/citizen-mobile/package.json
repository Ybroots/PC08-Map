{
  "name": "@atgt/citizen-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build": "tsc -p tsconfig.build.json && pnpm native:bundle:android",
    "native:bundle:android": "node -e \"require('node:fs').mkdirSync('dist/native/android-assets',{recursive:true})\" && react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/native/index.android.bundle --assets-dest dist/native/android-assets",
    "native:build:android:debug": "react-native build-android --tasks assembleDebug",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs --passWithNoTests"
  },
  "dependencies": {
    "@atgt/contracts": "workspace:*",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "react": "18.2.0",
    "react-native": "0.73.11",
    "react-native-get-random-values": "1.11.0",
    "react-native-keychain": "^10.0.0",
    "uuid": "11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli-platform-android": "12.3.7",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/gradle-plugin": "0.73.5",
    "@react-native/metro-config": "0.73.5",
    "@types/react": "18.3.31",
    "@types/react-test-renderer": "18.3.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "babel-jest": "^29.6.3",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.0"
  }
}
