# === RUNTIME ===
APP_ENV=development
APP_VERSION=0.0.1
LOG_LEVEL=debug

# === DATABASE ===
# Use secret store in production; never commit real passwords
DATABASE_URL=postgresql://atgt_app:CHANGE_ME@localhost:5432/atgt_dev
AUDIT_DATABASE_URL=postgresql://atgt_audit:CHANGE_ME@localhost:5432/atgt_dev
PRIVACY_DATABASE_URL=postgresql://atgt_privacy:CHANGE_ME@localhost:5432/atgt_dev

# === QUEUE ===
# RABBITMQ_ENDPOINTS=amqp://user:CHANGE_ME@localhost:5672
RABBITMQ_ENDPOINTS=amqps://CHANGE_ME
RABBITMQ_VHOST=/

# === REDIS ===
REDIS_SENTINELS=localhost:26379,localhost:26380,localhost:26381
REDIS_MASTER_NAME=mymaster

# === OBJECT STORAGE ===
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_QUARANTINE=atgt-quarantine
S3_BUCKET_ORIGINAL=atgt-evidence-original
S3_BUCKET_DERIVATIVE=atgt-evidence-derivative
# Credentials via secret store in production

# === IDENTITY (OIDC) ===
OIDC_ISSUER=https://CHANGE_ME/auth/realms/atgt
OIDC_CLIENT_ID=atgt-api
OIDC_AUDIENCE=atgt-api
OIDC_JWKS_URI=https://CHANGE_ME/auth/realms/atgt/protocol/openid-connect/certs
OIDC_JWKS_CACHE_TTL_MS=600000
OIDC_USE_MOCK=false
# Local/test only when OIDC_USE_MOCK=true; never enable in staging/production
# OIDC_MOCK_TOKEN from local secret storage
# OIDC_MOCK_SUBJECT=local-officer
# OIDC_MOCK_ROLE=dispatcher
# OIDC_MOCK_UNIT_IDS=
# OIDC_MOCK_AREA_IDS=
# OIDC_MOCK_CASE_IDS=
# OIDC_MOCK_MAX_DATA_CLASS=internal
# OIDC_MOCK_AUTHENTICATION_METHODS=pwd,mfa
# OIDC_MOCK_SESSION_ID=local-session
# OIDC_CLIENT_SECRET from secret store

# === ANONYMOUS CITIZEN SESSION ===
# Values require security review before production rollout
CITIZEN_SESSION_TTL_MINUTES=60
CITIZEN_SESSION_ROTATE_AFTER_MINUTES=15

# === VIETMAP ===
# Keys must come from secret store; never put plaintext here
VIETMAP_BASE_URL=https://maps.vietmap.vn
VIETMAP_SERVER_KEY_REF=secret:vietmap/server-key
VIETMAP_CLIENT_KEY_ALIAS=vm-client-1
VIETMAP_TIMEOUT_MS=5000
VIETMAP_QUOTA_WARNING_PCT=70

# === PRIVACY VAULT ===
VAULT_KEY_REF=secret:privacy/vault-key
PRIVACY_GRANT_TTL_HOURS=24
PRIVACY_POLICY_VERSION=PENDING

# === RETENTION ===
RETENTION_POLICY_VERSION=PENDING
# Auto-delete jobs are DISABLED until retention policy is approved

# === MAP DATA LIFECYCLE ===
# Fail-closed. When enabled, an approved deployment value is mandatory.
MAP_LIFECYCLE_WORKER_ENABLED=false
# MAP_LIFECYCLE_POLL_MS=

# === SOS INTAKE ===
# Fail-closed. Values below require an approved deployment decision.
SOS_INGEST_ENABLED=false
# SOS_INTAKE_AREA_ID=
# SOS_IDEMPOTENCY_TTL_MINUTES=

# === OUTBOX RELAY ===
# Fail-closed. Poll and batch values are mandatory when enabled.
OUTBOX_RELAY_ENABLED=false
# OUTBOX_RELAY_POLL_MS=
# OUTBOX_RELAY_BATCH_SIZE=

# === TELEMETRY ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=atgt-api
